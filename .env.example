# Copy to ignored .env.local. Use a separate Supabase project for development.
AUTH_ORIGIN=http://localhost:3000
# Public project URL and publishable key: Supabase project Connect / API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add NEXT_PUBLIC_ to these variables.
SUPABASE_SECRET_KEY=
# Supabase Connect > Transaction pooler URI, with database password URL-encoded.
DATABASE_URL=
SUPABASE_STORAGE_BUCKET=portal-cvs
# Independent random secret, at least 32 characters, for application upload tickets.
UPLOAD_TOKEN_SECRET=
